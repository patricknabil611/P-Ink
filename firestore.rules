rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserTask(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 2000 &&
             data.completed is bool &&
             data.clientCreatedAt is int &&
             data.clientCreatedAt >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidUserNote(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() <= 200 &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 20000 &&
             data.clientCreatedAt is int &&
             data.clientCreatedAt >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'text', 'completed', 'clientCreatedAt', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'text', 'completed', 'clientCreatedAt', 'createdAt', 'updatedAt']) &&
                         isValidUserTask(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidUserTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().clientCreatedAt == existing().clientCreatedAt &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'completed', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'clientCreatedAt', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'clientCreatedAt', 'createdAt', 'updatedAt']) &&
                         isValidUserNote(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidUserNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().clientCreatedAt == existing().clientCreatedAt &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
